<div class="fl-detail-panel" style="border-left: none; border-radius: var(--fl-radius-lg); overflow: hidden">

  <%# ─── Detail Header ───────────────────────────────────────── %>
  <div class="fl-detail-header">
    <div class="min-w-0 flex-1">
      <%# Breadcrumbs %>
      <nav class="fl-breadcrumbs" style="padding: 0; margin-bottom: 0.5rem">
        <a href="<%= logged_exceptions_path %>" class="fl-breadcrumb">Exceptions</a>
        <span class="fl-breadcrumb-sep">/</span>
        <span class="fl-breadcrumb-current"><%= @exception.exception_class %></span>
      </nav>

      <div class="flex items-center gap-2 flex-wrap">
        <span class="fl-badge fl-badge-<%= severity_for(@exception) %>"><%= @exception.exception_class %></span>
        <span class="fl-mono text-xs" style="color: var(--fl-text-secondary)"><%= @exception.controller_name %>#<%= @exception.action_name %></span>
      </div>

      <p class="mt-1.5 text-xs" style="color: var(--fl-text-muted)">
        <time datetime="<%= @exception.created_at.iso8601 %>"><%= @exception.created_at.strftime("%B %d, %Y at %I:%M:%S %p") %></time>
        <% if @exception.remote_ip.present? %>
          <span style="color: var(--fl-border)">·</span>
          <span class="fl-mono"><%= @exception.remote_ip %></span>
        <% end %>
      </p>
    </div>

    <div class="flex items-center gap-2 shrink-0">
      <%# Copy exception ID %>
      <button type="button"
        class="fl-copy-btn"
        data-action="click->faultline#copyId"
        data-faultline-id-value="<%= @exception.id %>"
        title="Copy exception ID">
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9.75a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184" /></svg>
        <span>ID</span>
      </button>

      <%# Copy message %>
      <button type="button"
        class="fl-copy-btn"
        data-action="click->faultline#copyMessage"
        data-faultline-message-value="<%= @exception.message %>"
        title="Copy message">
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>
        <span>Message</span>
      </button>

      <%# Close %>
      <button type="button"
        class="fl-icon-btn shrink-0"
        data-action="click->faultline#closeDetails"
        title="Close (Esc)">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>
  </div>

  <%# ─── Tabs ─────────────────────────────────────────────────── %>
  <% if @exception_tabs && @exception_tabs.values.count(true) > 1 %>
    <div class="fl-tabs" data-faultline-target="tabs">
      <button type="button" class="fl-tab active" data-action="click->faultline#switchTab" data-fl-tab-param="overview">Overview</button>
      <% if @exception_tabs[:backtrace] %>
        <button type="button" class="fl-tab" data-action="click->faultline#switchTab" data-fl-tab-param="backtrace">
          Backtrace
          <span class="fl-tab-badge"><%= @exception.backtrace.to_s.split("\n").length %></span>
        </button>
      <% end %>
      <% if @exception_tabs[:request] %>
        <button type="button" class="fl-tab" data-action="click->faultline#switchTab" data-fl-tab-param="request">Request</button>
      <% end %>
      <% if @exception_tabs[:environment] %>
        <button type="button" class="fl-tab" data-action="click->faultline#switchTab" data-fl-tab-param="environment">Environment</button>
      <% end %>
      <% if @exception_tabs[:user_info] %>
        <button type="button" class="fl-tab" data-action="click->faultline#switchTab" data-fl-tab-param="user_info">User Info</button>
      <% end %>
    </div>
  <% end %>

  <%# ─── Detail Body ─────────────────────────────────────────── %>
  <div class="fl-detail-body">

    <%# ─── Tab: Overview ────────────────────────────────────── %>
    <div data-faultline-target="tabContent" data-fl-tab-content="overview">

      <%# Message %>
      <div class="fl-detail-section">
        <div class="fl-detail-section-header">
          <h3>Message</h3>
        </div>
        <div class="fl-detail-code"><%= @exception.message %></div>
      </div>

      <%# Metadata Grid %>
      <% if Faultline.configuration.show_metadata %>
        <div class="fl-detail-section">
          <h3 style="margin-bottom: 0.5rem">Details</h3>
          <div class="fl-meta">
            <div class="fl-meta-item">
              <div class="fl-meta-label">Exception</div>
              <div class="fl-meta-value"><%= @exception.exception_class %></div>
            </div>
            <div class="fl-meta-item">
              <div class="fl-meta-label">Controller</div>
              <div class="fl-meta-value mono"><%= @exception.controller_name %></div>
            </div>
            <div class="fl-meta-item">
              <div class="fl-meta-label">Action</div>
              <div class="fl-meta-value mono"><%= @exception.action_name %></div>
            </div>
            <div class="fl-meta-item">
              <div class="fl-meta-label">Time</div>
              <div class="fl-meta-value"><time datetime="<%= @exception.created_at.iso8601 %>"><%= @exception.created_at.strftime("%Y-%m-%d %H:%M:%S %Z") %></time></div>
            </div>
            <% if @exception.remote_ip.present? %>
              <div class="fl-meta-item">
                <div class="fl-meta-label">IP Address</div>
                <div class="fl-meta-value mono"><%= @exception.remote_ip %></div>
              </div>
            <% end %>
            <% if @exception.user_agent.present? %>
              <div class="fl-meta-item" style="grid-column: span 2">
                <div class="fl-meta-label">User Agent</div>
                <div class="fl-meta-value" style="font-size: 0.8125rem; word-break: break-all"><%= @exception.user_agent %></div>
              </div>
            <% end %>
            <div class="fl-meta-item">
              <div class="fl-meta-label">Exception ID</div>
              <div class="fl-meta-value mono"><%= @exception.id %></div>
            </div>
            <% if @exception.id_value.present? %>
              <div class="fl-meta-item">
                <div class="fl-meta-label">ID Value</div>
                <div class="fl-meta-value mono"><%= @exception.id_value %></div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# Request Params %>
      <% if Faultline.configuration.show_request && @exception.request.present? %>
        <div class="fl-detail-section">
          <div class="fl-detail-section-header">
            <h3>Request</h3>
          </div>
          <div class="fl-detail-code"><%= pretty_format(@exception.request) %></div>
        </div>
      <% end %>

      <%# User Info %>
      <% if @exception.user_info.present? %>
        <div class="fl-detail-section">
          <div class="fl-detail-section-header">
            <h3>User Info</h3>
          </div>
          <div class="fl-detail-code"><%= pretty_format(@exception.user_info) %></div>
        </div>
      <% end %>
    </div>

    <%# ─── Tab: Backtrace ────────────────────────────────────── %>
    <div data-faultline-target="tabContent" data-fl-tab-content="backtrace" style="display: none">
      <% if @exception.backtrace.present? %>
        <% bt = format_backtrace(@exception.backtrace) %>
        <div class="fl-detail-section">
          <div class="fl-detail-section-header">
            <h3>Stack Trace</h3>
            <div class="flex items-center gap-2">
              <button type="button" class="fl-copy-btn" data-action="click->faultline#copyBacktrace"
                data-faultline-backtrace-value="<%= @exception.backtrace %>">
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9.75a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184" /></svg>
                Copy
              </button>
            </div>
          </div>
          <div class="fl-detail-pre" data-faultline-target="backtraceContent">
            <%= bt[:visible] %>
          </div>
          <% if bt[:hidden_count] > 0 %>
            <button type="button" class="fl-btn fl-btn-ghost fl-btn-sm mt-2"
              data-action="click->faultline#expandBacktrace">
              Show <%= bt[:hidden_count] %> more frames
            </button>
            <div class="fl-detail-pre mt-2" style="display: none" data-faultline-target="backtraceHidden">
              <%= bt[:hidden] %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-8">
          <p class="text-sm" style="color: var(--fl-text-muted)">No backtrace available</p>
        </div>
      <% end %>
    </div>

    <%# ─── Tab: Request ──────────────────────────────────────── %>
    <div data-faultline-target="tabContent" data-fl-tab-content="request" style="display: none">
      <% if @exception.request.present? %>
        <div class="fl-detail-section">
          <div class="fl-detail-section-header">
            <h3>Request Data</h3>
          </div>
          <div class="fl-detail-code" style="max-height: 32rem; overflow: auto"><%= pretty_format(@exception.request) %></div>
        </div>
      <% else %>
        <div class="text-center py-8">
          <p class="text-sm" style="color: var(--fl-text-muted)">No request data available</p>
        </div>
      <% end %>
    </div>

    <%# ─── Tab: Environment ──────────────────────────────────── %>
    <div data-faultline-target="tabContent" data-fl-tab-content="environment" style="display: none">
      <% if @exception.environment.present? %>
        <div class="fl-detail-section">
          <div class="fl-detail-section-header">
            <h3>Environment Variables</h3>
          </div>
          <div class="fl-detail-code" style="max-height: 32rem; overflow: auto"><%= pretty_format(@exception.environment) %></div>
        </div>
      <% else %>
        <div class="text-center py-8">
          <p class="text-sm" style="color: var(--fl-text-muted)">No environment data available</p>
        </div>
      <% end %>
    </div>

    <%# ─── Tab: User Info ────────────────────────────────────── %>
    <div data-faultline-target="tabContent" data-fl-tab-content="user_info" style="display: none">
      <% if @exception.user_info.present? %>
        <div class="fl-detail-section">
          <div class="fl-detail-section-header">
            <h3>User Information</h3>
          </div>
          <div class="fl-detail-code"><%= pretty_format(@exception.user_info) %></div>
        </div>
      <% else %>
        <div class="text-center py-8">
          <p class="text-sm" style="color: var(--fl-text-muted)">No user info available</p>
        </div>
      <% end %>
    </div>

  </div>

  <%# ─── Actions Footer ──────────────────────────────────────── %>
  <div class="flex items-center justify-between px-5 py-3" style="border-top: 1px solid var(--fl-border-light); background: var(--fl-bg-secondary)">
    <p class="text-xs fl-mono" style="color: var(--fl-text-muted)">
      ID: <%= @exception.id %>
      <span style="color: var(--fl-border)">·</span>
      <time datetime="<%= @exception.created_at.iso8601 %>"><%= @exception.created_at.iso8601 %></time>
    </p>
    <%= link_to logged_exception_path(@exception),
      class: "fl-btn fl-btn-ghost fl-btn-sm",
      style: "color: var(--fl-danger); border-color: var(--fl-danger)",
      data: { turbo_method: :delete, turbo_confirm: t(".confirm_delete"), turbo_stream: true } do %>
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" /></svg>
      Delete
    <% end %>
  </div>

  <%# ─── Prev/Next Navigation ────────────────────────────────── %>
  <% if Faultline.configuration.enable_navigation && (prev_exception || next_exception) %>
    <div class="fl-nav-row">
      <% if prev_exception %>
        <%= link_to logged_exception_path(prev_exception, params_filters),
          class: "fl-nav-link",
          data: { turbo_frame: "exception-details", turbo_action: "advance" } do %>
          <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
          <div class="min-w-0">
            <div class="fl-nav-link-label">Previous</div>
            <div class="fl-nav-link-title"><%= prev_exception.id %></div>
          </div>
        <% end %>
      <% else %>
        <div></div>
      <% end %>

      <% if next_exception %>
        <%= link_to logged_exception_path(next_exception, params_filters),
          class: "fl-nav-link",
          style: "text-align: right",
          data: { turbo_frame: "exception-details", turbo_action: "advance" } do %>
          <div class="min-w-0">
            <div class="fl-nav-link-label">Next</div>
            <div class="fl-nav-link-title"><%= next_exception.id %></div>
          </div>
          <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
        <% end %>
      <% else %>
        <div></div>
      <% end %>
    </div>
  <% end %>

</div>
