<% page_title t(".title", default: "N+1 Query Patterns") %>

<div class="space-y-6">
  <%# ─── Header ──────────────────────────────────────────────── %>
  <nav class="rn-breadcrumbs" aria-label="Breadcrumb">
    <a href="<%= root_path %>" class="rn-breadcrumb">Dashboard</a>
    <span class="rn-breadcrumb-sep">/</span>
    <span class="rn-breadcrumb-current">N+1 Query Patterns</span>
  </nav>

  <div class="flex items-center gap-3">
    <svg class="w-6 h-6" style="color: var(--rn-primary)" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
    </svg>
    <h1 class="text-2xl font-bold" style="color: var(--rn-text)">N+1 Query Patterns</h1>
  </div>
  <p class="text-sm" style="color: var(--rn-text-muted)">
    Detects N+1 query patterns from exception breadcrumbs (SQL queries) and backtrace analysis.
    Breadcrumbs are now enabled — capture exceptions in your app to populate this page.
  </p>

  <%# ─── Summary Stats ───────────────────────────────────────── %>
  <% if @summary %>
    <div class="rn-stats">
      <div class="rn-stat">
        <span class="rn-stat-label">Unique Patterns</span>
        <span class="rn-stat-value"><%= @summary[:unique_patterns] %></span>
        <span class="rn-stat-change">Distinct query groups</span>
      </div>
      <div class="rn-stat">
        <span class="rn-stat-label">Total Repetitions</span>
        <span class="rn-stat-value danger"><%= number_with_delimiter(@summary[:total_patterns]) %></span>
        <span class="rn-stat-change">Similar queries detected</span>
      </div>
      <% if @summary[:worst_pattern] %>
        <div class="rn-stat">
          <span class="rn-stat-label">Worst Offender</span>
          <span class="rn-stat-value" style="font-size: 0.875rem"><%= @summary[:worst_pattern][:table] %></span>
          <span class="rn-stat-change"><%= @summary[:worst_pattern][:count] %> repetitions</span>
        </div>
      <% end %>
      <div class="rn-stat">
        <span class="rn-stat-label">Top Tables</span>
        <span class="rn-stat-value"><%= @summary[:top_tables]&.size || 0 %></span>
        <span class="rn-stat-change">Affected tables</span>
      </div>
    </div>
  <% end %>

  <%# ─── Top Tables Breakdown ───────────────────────────────── %>
  <% if @summary && @summary[:top_tables]&.any? %>
    <div class="rn-card">
      <div class="p-4" style="border-bottom: 1px solid var(--rn-border-light)">
        <h2 class="text-sm font-semibold" style="color: var(--rn-text)">Top Affected Tables</h2>
        <p class="text-xs mt-1" style="color: var(--rn-text-muted)">Tables with the most N+1 query repetitions</p>
      </div>
      <div class="p-4">
        <div class="space-y-3">
          <% max_count = @summary[:top_tables].map { |t| t[:count] }.max.to_f %>
          <% @summary[:top_tables].each do |table_data| %>
            <div>
              <div class="flex items-center justify-between mb-1">
                <span class="text-sm font-medium" style="color: var(--rn-text)"><code><%= table_data[:table] %></code></span>
                <span class="text-xs font-semibold" style="color: var(--rn-danger)"><%= table_data[:count] %> queries</span>
              </div>
              <div class="rn-progress" style="height: 8px">
                <div class="rn-progress-bar danger" style="width: <%= (table_data[:count] / max_count * 100).round %>%"></div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <%# ─── Patterns Table ─────────────────────────────────────── %>
  <div class="rn-card">
    <div class="p-4" style="border-bottom: 1px solid var(--rn-border-light)">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4" style="color: var(--rn-danger)" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
        </svg>
        <h2 class="text-sm font-semibold" style="color: var(--rn-text)">Detected Patterns</h2>
      </div>
      <p class="text-xs mt-1" style="color: var(--rn-text-muted)">
        Queries with 3+ similar occurrences in a single exception's breadcrumbs
      </p>
    </div>

    <% if @patterns.any? %>
      <div class="rn-table-wrap">
        <table class="rn-table">
          <thead>
            <tr>
              <th>Table</th>
              <th>Count</th>
              <th>Avg Duration</th>
              <th>Sample</th>
              <th>Source</th>
              <th>Exception IDs</th>
            </tr>
          </thead>
          <tbody>
            <% @patterns.each do |pattern| %>
              <tr>
                <td>
                  <span class="rn-badge"><%= pattern[:table] %></span>
                </td>
                <td>
                  <span class="font-bold" style="color: var(--rn-danger)"><%= pattern[:count] %></span>
                </td>
                <td>
                  <span style="color: var(--rn-text-secondary)"><%= pattern[:avg_duration] %>ms</span>
                </td>
                <td>
                  <code class="text-xs" style="color: var(--rn-text-muted); word-break: break-all; max-width: 400px; display: inline-block">
                    <%= truncate(pattern[:sql_sample], length: 120) %>
                  </code>
                </td>
                <td>
                  <span class="rn-badge rn-badge-<%= pattern[:source] == :breadcrumbs ? 'info' : 'warning' %>">
                    <%= pattern[:source] == :breadcrumbs ? 'SQL' : 'Backtrace' %>
                  </span>
                </td>
                <td>
                  <% pattern[:exception_ids]&.each do |eid| %>
                    <%= link_to "##{eid}", logged_exception_path(eid), class: "text-xs", style: "color: var(--rn-primary)", data: { turbo_frame: "exception-details" } %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="p-8 text-center">
        <svg class="w-10 h-10 mx-auto" style="color: var(--rn-text-muted)" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <p class="mt-3 text-sm font-medium" style="color: var(--rn-text-muted)">No N+1 patterns detected</p>
        <p class="mt-1 text-xs" style="color: var(--rn-text-muted)">
          Capture some exceptions in your application to populate this page.
          N+1 patterns are detected from both SQL breadcrumbs and backtrace analysis.
        </p>
        <% unless RailsNexus.configuration.breadcrumbs_enabled %>
          <p class="mt-2 text-xs font-medium" style="color: var(--rn-warning)">
            ⚠ Breadcrumbs are disabled. Enable <code>config.breadcrumbs_enabled = true</code> for better N+1 detection.
          </p>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
