<div class="p-5 space-y-5">
  <%# Header %>
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0">
      <div class="flex items-center gap-2 flex-wrap">
        <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-semibold bg-red-50 text-red-700 border border-red-100">
          <%= @exception.exception_class %>
        </span>
        <span class="text-xs text-gray-400">•</span>
        <span class="text-xs text-gray-400 font-mono"><%= @exception.controller_name %>#<%= @exception.action_name %></span>
      </div>
      <p class="mt-2 text-sm text-gray-500">
        <time datetime="<%= @exception.created_at.iso8601 %>"><%= @exception.created_at.strftime("%B %d, %Y at %I:%M %p") %></time>
        <% if @exception.remote_ip.present? %>
          <span class="text-gray-300 mx-1">•</span>
          <span class="font-mono text-gray-400"><%= @exception.remote_ip %></span>
        <% end %>
      </p>
    </div>
    <button type="button"
      class="shrink-0 p-1.5 rounded-lg text-gray-400 hover:text-gray-600 hover:bg-gray-100 transition-colors"
      data-action="click->faultline#closeDetails">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
    </button>
  </div>

  <%# Message %>
  <div>
    <h3 class="text-[11px] font-semibold text-gray-400 uppercase tracking-wider mb-1.5">Message</h3>
    <div class="bg-gray-50 rounded-lg border border-gray-100 p-3">
      <pre class="text-sm text-gray-700 whitespace-pre-wrap font-mono leading-relaxed"><%= @exception.message %></pre>
    </div>
  </div>

  <%# Request Info %>
  <div>
    <h3 class="text-[11px] font-semibold text-gray-400 uppercase tracking-wider mb-1.5">Request</h3>
    <div class="bg-gray-50 rounded-lg border border-gray-100 p-3">
      <pre class="text-xs text-gray-600 whitespace-pre-wrap font-mono leading-relaxed"><%= pretty_format(@exception.request) %></pre>
    </div>
  </div>

  <%# Backtrace %>
  <div>
    <h3 class="text-[11px] font-semibold text-gray-400 uppercase tracking-wider mb-1.5">Backtrace</h3>
    <div class="bg-gray-900 rounded-lg p-3 overflow-auto max-h-80 border border-gray-800">
      <pre class="text-xs text-gray-300 whitespace-pre-wrap font-mono leading-relaxed"><%= @exception.backtrace %></pre>
    </div>
  </div>

  <%# Environment %>
  <div>
    <h3 class="text-[11px] font-semibold text-gray-400 uppercase tracking-wider mb-1.5">Environment</h3>
    <div class="bg-gray-50 rounded-lg border border-gray-100 p-3 overflow-auto max-h-56">
      <pre class="text-xs text-gray-600 whitespace-pre-wrap font-mono leading-relaxed"><%= pretty_format(@exception.environment) %></pre>
    </div>
  </div>

  <%# User Info %>
  <% if @exception.user_info.present? %>
    <div>
      <h3 class="text-[11px] font-semibold text-gray-400 uppercase tracking-wider mb-1.5">User Info</h3>
      <div class="bg-gray-50 rounded-lg border border-gray-100 p-3">
        <pre class="text-xs text-gray-600 whitespace-pre-wrap font-mono leading-relaxed"><%= pretty_format(@exception.user_info) %></pre>
      </div>
    </div>
  <% end %>

  <%# Actions %>
  <div class="flex items-center justify-between pt-4 border-t border-gray-100">
    <p class="text-xs text-gray-400 font-mono">
      ID: <%= @exception.id %>
      <span class="text-gray-200 mx-1">•</span>
      <time datetime="<%= @exception.created_at.iso8601 %>"><%= @exception.created_at.iso8601 %></time>
    </p>
    <%= link_to logged_exception_path(@exception),
      class: "inline-flex items-center gap-1 px-2.5 py-1 text-xs font-medium text-red-600 bg-red-50 border border-red-200 rounded-lg hover:bg-red-100 transition-colors",
      data: { turbo_method: :delete, turbo_confirm: t(".confirm_delete"), turbo_stream: true } do %>
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" /></svg>
      Delete
    <% end %>
  </div>
</div>
